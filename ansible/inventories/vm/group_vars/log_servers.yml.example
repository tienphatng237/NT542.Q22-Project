# SSH connection details for the Linux Wazuh server.
ansible_connection: ssh
ansible_user: ubuntu

# Elevate on the Linux server for package installation and service setup.
ansible_become: true
ansible_become_method: sudo
ansible_ssh_private_key_file: /absolute/path/to/lab-key

# Optional: override the manager address if agents must enroll against a DNS name.
# wazuh_manager_address: log01.example.local

# Optional: let Ansible enforce a known Wazuh dashboard admin password.
# Leave empty to manage the password manually after installation.
wazuh_dashboard_admin_password: CHANGE_ME
